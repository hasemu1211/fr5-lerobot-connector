<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="fairino5_v6_robot_ros2_control" params="name initial_positions_file use_fake_hardware">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_fake_hardware}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:unless value="${use_fake_hardware}">
                    <plugin>fairino_hardware/FairinoHardwareInterface</plugin>
                    <param name="controller_ip">$(optenv FR5_CONTROLLER_IP 192.168.58.2)</param>
                    <param name="gripper_index">$(optenv FR5_GRIPPER_INDEX 1)</param>
                    <param name="gripper_max_time">$(optenv FR5_GRIPPER_MAX_TIME 30000)</param>
                    <param name="gripper_upper_position">$(optenv FR5_GRIPPER_UPPER_POSITION 0.021)</param>
                </xacro:unless>
                <param name="gripper_velocity">$(optenv FR5_GRIPPER_VELOCITY 20)</param>
                <param name="gripper_force">$(optenv FR5_GRIPPER_FORCE 50)</param>
                <param name="gripper_settle_time_ms">$(optenv FR5_GRIPPER_SETTLE_TIME_MS 500)</param>
            </hardware>
            <joint name="j1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['j1']}</param>
                </state_interface>
            </joint>
            <joint name="j2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['j2']}</param>
                </state_interface>
            </joint>
            <joint name="j3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['j3']}</param>
                </state_interface>
            </joint>
            <joint name="j4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['j4']}</param>
                </state_interface>
            </joint>
            <joint name="j5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['j5']}</param>
                </state_interface>
            </joint>
            <joint name="j6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['j6']}</param>
                </state_interface>
            </joint>
            <joint name="finger_right_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['finger_right_joint']}</param>
                </state_interface>
            </joint>
        </ros2_control>
    </xacro:macro>
</robot>

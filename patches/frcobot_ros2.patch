+hardware_interface::CallbackReturn FairinoHardwareInterface::on_configure(const rclcpp_lifecycle::State &)
+{
+    if (!_require_gripper_source_clock) return hardware_interface::CallbackReturn::SUCCESS;
+    // Use the framework-managed node. No new executor, command endpoint or motion owner.
+    auto node = get_node();
+    if (!node) return hardware_interface::CallbackReturn::ERROR;
+    if (!node->has_parameter("gripper_temporal_policy_v1"))
+        node->declare_parameter("gripper_temporal_policy_v1", std::vector<double>{});
+    try { _precise_clock = std::make_unique<PreciseControllerClock>(_controller_ip); }
+    catch (const std::exception &) { return hardware_interface::CallbackReturn::ERROR; }
+    return hardware_interface::CallbackReturn::SUCCESS;
+}

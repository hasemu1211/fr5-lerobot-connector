+        const double q1 = _precise_clock->read(timeout_ms(), cancelled);
+        const double m1 = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        const double s1 = std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();

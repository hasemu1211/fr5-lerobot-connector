+// Numeric encoding of fr5.gripper_source_clock.v1 plus the existing age bound.
+// Supplied by the runtime owner, never estimated from an SDK/ROS receipt.
+struct GripperSourceClock {
+  std::array<double, 11> values{};
+  GripperSourceClock() = default;
+  explicit GripperSourceClock(const std::vector<double> &input) {
+    if (input.size() == values.size()) std::copy(input.begin(), input.end(), values.begin());
+  }
+  bool valid(const std::array<uint32_t, 4> &incarnation, double system, double steady) const {
+    for (double value : values) if (!std::isfinite(value)) return false;
+    if (values[0] != 1. || !std::isfinite(system) || !std::isfinite(steady)) return false;
+    bool nonzero = false;
+    for (size_t i = 0; i < 4; ++i) {
+      if (values[i + 1] != double(incarnation[i])) return false;
+      nonzero = nonzero || incarnation[i] != 0;
+    }
+    return nonzero && values[6] >= 0. && values[8] >= 0. && values[9] > values[7] &&
+      values[10] > 0. && system >= values[7] && system <= values[9] &&
+      std::abs((system - values[7]) - (steady - values[8])) <= values[6];
+  }
+  static double calendar(const std::array<double, 7> &stamp) {
+    for (double value : stamp)
+      if (!std::isfinite(value) || value < 0. || value > 9999. || value != std::floor(value))
+        return std::numeric_limits<double>::quiet_NaN();
+    if (stamp[0] < 1. || stamp[6] > 999.) return std::numeric_limits<double>::quiet_NaN();
+    std::tm time{};
+    time.tm_year = int(stamp[0]) - 1900; time.tm_mon = int(stamp[1]) - 1;
+    time.tm_mday = int(stamp[2]); time.tm_hour = int(stamp[3]);
+    time.tm_min = int(stamp[4]); time.tm_sec = int(stamp[5]);
+    // UTC is a deterministic encoding only; values[5] supplies the measured mapping.
+    const auto encoded = timegm(&time);
+    if (time.tm_year != int(stamp[0]) - 1900 || time.tm_mon != int(stamp[1]) - 1 ||
+        time.tm_mday != stamp[2] || time.tm_hour != stamp[3] ||
+        time.tm_min != stamp[4] || time.tm_sec != stamp[5])
+      return std::numeric_limits<double>::quiet_NaN();
+    return double(encoded) + stamp[6] / 1000.;
+  }
+  bool fresh(const std::array<double, 7> &stamp, const std::array<uint32_t, 4> &incarnation,
+             double system, double steady) const {
+    const double source = calendar(stamp) + values[5];
+    return valid(incarnation, system, steady) && std::isfinite(source) &&
+      source + values[6] <= system && system - (source - values[6]) <= values[10];
+  }
+  bool after_command(const std::array<double, 7> &stamp, double started) const {
+    const double source = calendar(stamp) + values[5];
+    return std::isfinite(source) && std::isfinite(started) && source - values[6] > started;
+  }
+};

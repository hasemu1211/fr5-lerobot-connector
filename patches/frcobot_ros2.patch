 #include "fairino_hardware/fairino_hardware_interface.hpp"
 
+#include <charconv>
+#include <string_view>
+
+namespace {
+
+std::atomic<int> udp_command_error{0};
+std::atomic<uint64_t> udp_reply_count{0};
+
+void capture_udp_command_reply(
+    int com_type, int, int, int, std::string content)
+{
+    if (com_type != 1) return;
+    udp_reply_count.fetch_add(1, std::memory_order_relaxed);
+    constexpr std::string_view marker{"robot errcode:"};
+    const auto marker_position = content.rfind(marker);
+    if (marker_position == std::string::npos) return;
+    const char *first = content.data() + marker_position + marker.size();
+    const char *last = content.data() + content.size();
+    int error = 0;
+    const auto parsed = std::from_chars(first, last, error);
+    if (parsed.ec == std::errc{} && error != 0) {
+        int expected = 0;
+        udp_command_error.compare_exchange_strong(expected, error);
+    }
+}
+
+struct UdpCommandResult {
+    int send_error;
+    bool reply_received;
+    int controller_error;
+
+    bool ok() const
+    {
+        // FAIRINO's UDP callback reports controller rejections, but it does not
+        // acknowledge every successful command. Absence of a reply is therefore
+        // not a failure; delayed non-zero replies remain sticky in write().
+        return send_error == 0 && controller_error == 0;
+    }
+};
+
+template<typename Send>
+UdpCommandResult send_udp_command_and_observe(Send send)
+{
+    const auto replies_before = udp_reply_count.load(std::memory_order_relaxed);
+    const int send_error = send();
+    if (send_error != 0) {
+        return {send_error, false, udp_command_error.load()};
+    }
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(50);
+    while (udp_reply_count.load(std::memory_order_relaxed) == replies_before &&
+           std::chrono::steady_clock::now() < deadline) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    return {
+        send_error,
+        udp_reply_count.load(std::memory_order_relaxed) != replies_before,
+        udp_command_error.load(),
+    };
+}
+

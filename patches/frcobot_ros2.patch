+        _gripper_error = -5; _arm_stream_paused = true;
+        return false;
+    }
+}
+bool FairinoHardwareInterface::certified_gripper_observation(
+    ROBOT_STATE_PKG &state, std::array<double,92> &certificate, double after_steady)
+{
+    if (!refresh_gripper_freshness(after_steady)) return false;
+    std::lock_guard<std::mutex> lock(_gripper_mutex);
+    if (_stop_gripper_thread || _gripper_error || udp_command_error) return false;
+    certificate = _gripper_current_sample; state = _gripper_current_state;
+    const double system=std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+    const double steady=std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    for(size_t i=0;i<4;++i) if(certificate[1+i]!=double(_gripper_evidence.incarnation[i])) return false;
+    if (certificate[67]!=state.gripper_position || certificate[68]!=state.gripper_motiondone || certificate[69]!=state.gripper_fault ||
+        certificate[19]!=state.frame_cnt || certificate[58]!=GripperSourceClock::calendar(GripperExecutionEvidence::source(state))) return false;
+    return certificate[8]==_last_gripper_command.load() && certificate[5]==double(_gripper_command_generation.load()) && certificate[39]>=after_steady &&
+        current_gripper_fresh(certificate, system, steady, certificate[42]);
+}
+void FairinoHardwareInterface::sample_gripper_evidence()
+{
+    _gripper_evidence_values[27] = 0.;
+    // Reuse the existing SDK cached-state reader; never label local read time source time.
+    ROBOT_STATE_PKG state{};
+    const int result = _ptr_robot->GetRobotRealTimeState(&state);
+    const double system_s = std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+    const double steady_s = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    std::unique_lock<std::mutex> lock(_gripper_mutex, std::try_to_lock);
+    if (!lock.owns_lock()) return;
+    const auto raw = _gripper_evidence.snapshot(
+      _gripper_command_generation.load(), _last_gripper_command.load(), system_s, steady_s,
+      state, _gripper_upper_position, _pending_gripper_position.has_value(),
+      _gripper_rpc_active.load(), _arm_stream_paused.load(), _stop_gripper_thread,
+      _gripper_error.load() != 0 ? _gripper_error.load() : udp_command_error.load(), result == 0);
+    std::copy(raw.begin(), raw.end(), _gripper_evidence_values.begin());
+    _gripper_raw_sample = raw; _gripper_raw_state = state;
+    if (_require_gripper_source_clock && _precise_clock) {
+        _gripper_evidence_values[0] = 4.;
+        // Never stamp an old certified frame with this read's new receipt times.
+        const auto &c = _gripper_current_sample;
+        bool same = c[35] == 1. && raw[27] == 1.;
+        for (size_t i : {size_t(5), size_t(6), size_t(7), size_t(8), size_t(21), size_t(22), size_t(23), size_t(24), size_t(25), size_t(26)})
+            same = same && c[i] == raw[i];
+        for (size_t i = 1; i <= 4; ++i) same = same && c[i] == raw[i];
+        if (same) {
+            std::array<double,7> stamp{raw[12],raw[13],raw[14],raw[15],raw[16],raw[17],raw[18]};
+            std::array<double,7> old{c[12],c[13],c[14],c[15],c[16],c[17],c[18]};
+            if (stamp < old) {
+                RCLCPP_ERROR(rclcpp::get_logger("FairinoHardwareInterface"),
+                    "GRIPPER_SOURCE_REGRESSED raw=%.6f certified=%.6f raw_received=%.6f certified_received=%.6f",
+                    GripperSourceClock::calendar(stamp), GripperSourceClock::calendar(old), raw[10], c[10]);
+                _gripper_error = -5; same = false;
+            }
+        }
+        if (same) {
+            std::copy(c.begin(), c.end(), _gripper_evidence_values.begin());
+            _gripper_evidence_values[0] = 4.;
+            std::copy(_gripper_evidence.selected.begin(), _gripper_evidence.selected.end(), _gripper_evidence_values.begin()+92);
+        }
+        else { _gripper_evidence_values[27] = 0.; _gripper_evidence_values[35] = 0.; }
+    }
+    _gripper_cv.notify_all();
+}
 

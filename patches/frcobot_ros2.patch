+#ifndef FR5_PRECISE_CONTROLLER_CLOCK_HPP
+#define FR5_PRECISE_CONTROLLER_CLOCK_HPP
+#include <curl/curl.h>
+#include <arpa/inet.h>
+#include <tinyxml2.h>
+#include <cmath>
+#include <functional>
+#include <stdexcept>
+#include <string>
+namespace fairino_hardware {
+// One read-only RPC client in the existing worker; never construct another SDK.
+class PreciseControllerClock {
+  CURL *client_{nullptr};
+  std::string body_, url_;
+  std::function<bool()> cancelled_;
+  static size_t receive(char *data, size_t size, size_t count, void *target) {
+    auto &body = *static_cast<std::string*>(target);
+    if (size && count>65536/size) return 0;
+    const size_t n=size*count;
+    if (body.size()+n>65536) return 0;
+    body.append(data,n); return n;
+  }
+  static int progress(void *self, curl_off_t, curl_off_t, curl_off_t, curl_off_t) {
+    return static_cast<PreciseControllerClock*>(self)->cancelled_() ? 1 : 0;
+  }
+public:
+  explicit PreciseControllerClock(const std::string &ip) {
+    in_addr address{};
+    if(inet_pton(AF_INET,ip.c_str(),&address)!=1) throw std::runtime_error("clock IPv4");
+    static const auto initialized=curl_global_init(CURL_GLOBAL_DEFAULT);
+    if (initialized!=CURLE_OK || !(client_=curl_easy_init())) throw std::runtime_error("clock client");
+    url_="http://"+ip+":20003/RPC2";
+  }
+  ~PreciseControllerClock() { if(client_) curl_easy_cleanup(client_); }
+  PreciseControllerClock(const PreciseControllerClock &)=delete;
+  PreciseControllerClock &operator=(const PreciseControllerClock &)=delete;
+  static double parse(const std::string &body) {
+    tinyxml2::XMLDocument xml;
+    if(xml.Parse(body.data(),body.size())!=tinyxml2::XML_SUCCESS) throw std::runtime_error("clock XML");
+    auto *node=xml.FirstChildElement("methodResponse");
+    for(const char *name:{"params","param","value","array","data"}) node=node?node->FirstChildElement(name):nullptr;
+    auto *code=node?node->FirstChildElement("value"):nullptr;
+    auto *value=code?code->NextSiblingElement("value"):nullptr;
+    auto *status=code?code->FirstChildElement():nullptr;
+    auto *number=value?value->FirstChildElement("double"):nullptr;
+    int error=-1; double ms=0.;
+    if(!code || !value || value->NextSiblingElement() || !status ||
+       (std::string(status->Name())!="int" && std::string(status->Name())!="i4") ||
+       status->QueryIntText(&error)!=tinyxml2::XML_SUCCESS || error || !number ||
+       number->QueryDoubleText(&ms)!=tinyxml2::XML_SUCCESS || !std::isfinite(ms) || ms<=0. || ms>=1e15)
+      throw std::runtime_error("clock response");
+    return ms/1000.;
+  }
+  double read(long timeout_ms, std::function<bool()> cancelled) {
+    cancelled_=std::move(cancelled);
+    if(cancelled_() || timeout_ms<=0) throw std::runtime_error("clock cancelled");
+    body_.clear();
+    curl_easy_setopt(client_,CURLOPT_URL,url_.c_str());
+    curl_easy_setopt(client_,CURLOPT_PROXY,"");
+    curl_easy_setopt(client_,CURLOPT_POSTFIELDS,"<?xml version=\"1.0\"?><methodCall><methodName>GetSystemClock</methodName><params/></methodCall>");
+    curl_easy_setopt(client_,CURLOPT_CONNECTTIMEOUT_MS,timeout_ms);
+    curl_easy_setopt(client_,CURLOPT_TIMEOUT_MS,timeout_ms);
+    curl_easy_setopt(client_,CURLOPT_NOSIGNAL,1L);
+    curl_easy_setopt(client_,CURLOPT_WRITEFUNCTION,receive);
+    curl_easy_setopt(client_,CURLOPT_WRITEDATA,&body_);
+    curl_easy_setopt(client_,CURLOPT_NOPROGRESS,0L);
+    curl_easy_setopt(client_,CURLOPT_XFERINFOFUNCTION,progress);
+    curl_easy_setopt(client_,CURLOPT_XFERINFODATA,this);
+    const auto result=curl_easy_perform(client_);
+    long status=0; curl_easy_getinfo(client_,CURLINFO_RESPONSE_CODE,&status);
+    const bool aborted=cancelled_();
+    if(result!=CURLE_OK || status!=200 || aborted) {
+      double elapsed=0.; curl_easy_getinfo(client_,CURLINFO_TOTAL_TIME,&elapsed);
+      throw std::runtime_error("clock query: curl="+std::to_string(int(result))+
+        " http="+std::to_string(status)+" cancelled="+std::to_string(aborted)+
+        " elapsed_s="+std::to_string(elapsed)+" timeout_ms="+std::to_string(timeout_ms));
+    }
+    return parse(body_);
+  }
+};
+}
+#endif

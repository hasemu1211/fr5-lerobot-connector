+void FairinoHardwareInterface::stop_gripper_worker()
+{
+    if (!_gripper_thread.joinable()) return;
+    {
+        std::lock_guard<std::mutex> lock(_gripper_mutex);
+        _stop_gripper_thread = true;
+        _pending_gripper_position.reset();
+    }
+    _gripper_cv.notify_one();
+    if (_gripper_rpc_active.load()) {
+        RCLCPP_WARN(rclcpp::get_logger("FairinoHardwareInterface"),
+            "Waiting for an in-flight gripper RPC; lifecycle deactivation is not a gripper safety stop");
+    }
+    _gripper_thread.join();
+}
+
+void FairinoHardwareInterface::gripper_worker()
+{
+    using namespace std::chrono_literals;
+    size_t idle_invalid_feedback_samples = 0;
+    while (true) {
+        std::optional<int> position;
+        uint64_t command_generation = 0;
+        {
+            std::unique_lock<std::mutex> lock(_gripper_mutex);
+            _gripper_cv.wait_for(lock, 50ms, [this] {
+                return _stop_gripper_thread || _pending_gripper_position.has_value();
+            });
+            if (_stop_gripper_thread) return;
+            position = _pending_gripper_position;
+            _pending_gripper_position.reset();
+            command_generation = _gripper_command_generation.load();
+        }
+        if (position.has_value()) {
+            bool resume_arm = false;
+            ROBOT_STATE_PKG initial_state{};
+            _gripper_rpc_active = true;
+            const int initial_state_result =
+                _ptr_robot->GetRobotRealTimeState(&initial_state);
+            _gripper_rpc_active = false;
+            if (initial_state_result != 0 || initial_state.gripper_fault != 0 ||
+                initial_state.gripper_position > 100) {
+                _gripper_error = initial_state_result != 0 ?
+                    initial_state_result :
+                    (initial_state.gripper_fault != 0 ?
+                        -static_cast<int>(initial_state.gripper_fault) : -3);
+                RCLCPP_ERROR(rclcpp::get_logger("FairinoHardwareInterface"),
+                    "GetRobotRealTimeState returned invalid gripper state before motion, error=%d fault=%u position=%u",
+                    initial_state_result, initial_state.gripper_fault,
+                    initial_state.gripper_position);
+                return;
+            }
+            uint8_t last_feedback = initial_state.gripper_position;
+            const bool opening = *position > static_cast<int>(last_feedback);
+            const int velocity = opening ? _gripper_open_velocity : _gripper_velocity;
+            const int force = opening ? _gripper_open_force : _gripper_force;
+            RCLCPP_INFO(rclcpp::get_logger("FairinoHardwareInterface"),
+                "Gripper command direction=%s target=%d feedback=%u velocity=%d force=%d",
+                opening ? "OPEN" : "CLOSE", *position, last_feedback, velocity, force);
+            _gripper_rpc_active = true;
+            const int result = _ptr_robot->MoveGripper(
+                _gripper_index, *position, velocity, force,
+                _gripper_max_time, 1, 0, 0, 0, 0);
+            _gripper_rpc_active = false;
+            if (result != 0) {
+                _gripper_error = result;
+                RCLCPP_ERROR(rclcpp::get_logger("FairinoHardwareInterface"),
+                    "MoveGripper failed in non-realtime worker, error code: %d", result);
+                return;
+            }
+            const auto deadline = std::chrono::steady_clock::now() +
+                std::chrono::milliseconds(_gripper_max_time);
+            const auto settle_time = std::chrono::milliseconds(_gripper_settle_time_ms);
+            bool observed_movement = false;
+            size_t invalid_feedback_samples = 0;
+            std::optional<std::chrono::steady_clock::time_point> non_target_stable_since;
+            while (true) {
+                ROBOT_STATE_PKG state{};
+                _gripper_rpc_active = true;
+                const int state_result = _ptr_robot->GetRobotRealTimeState(&state);
+                _gripper_rpc_active = false;
+                if (state_result != 0 || state.gripper_fault != 0) {
+                    _gripper_error = state_result != 0 ?
+                        state_result : -static_cast<int>(state.gripper_fault);
+                    RCLCPP_ERROR(rclcpp::get_logger("FairinoHardwareInterface"),
+                        "GetRobotRealTimeState failed during gripper motion, error=%d fault=%u",
+                        state_result, state.gripper_fault);
+                    return;
+                }
+                const uint8_t feedback = state.gripper_position;
+                const uint8_t motion_done = state.gripper_motiondone;
+                const bool feedback_is_plausible = feedback <= 100 && (opening ?
+                    (feedback + 1 >= last_feedback && feedback <= *position + 1) :
+                    (feedback <= last_feedback + 1 && feedback + 1 >= *position));
+                if (!feedback_is_plausible) {
+                    ++invalid_feedback_samples;
+                    if (invalid_feedback_samples == 1) {
+                        RCLCPP_WARN(rclcpp::get_logger("FairinoHardwareInterface"),
+                            "Holding last valid gripper feedback (direction=%s target=%d previous=%u raw=%u motion_done=%u)",
+                            opening ? "OPEN" : "CLOSE", *position, last_feedback,
+                            feedback, motion_done);
+                    }
+                } else if (invalid_feedback_samples != 0) {
+                    RCLCPP_WARN(rclcpp::get_logger("FairinoHardwareInterface"),
+                        "Realtime gripper feedback recovered after %zu invalid samples (target=%d feedback=%u)",
+                        invalid_feedback_samples, *position, feedback);
+                    invalid_feedback_samples = 0;
+                }
+                // Some grippers briefly report the commanded endpoint before motion is done.
+                // Keep intermediate feedback, but expose the endpoint only after completion.
+                if (feedback_is_plausible &&
+                    (motion_done != 0 || feedback != static_cast<uint8_t>(*position))) {
+                    _gripper_position_state =
+                        _gripper_upper_position * static_cast<double>(feedback) / 100.0;
+                }
+                if (motion_done != 0) {
+                    if (!feedback_is_plausible) {
+                        _gripper_error = -2;
+                        RCLCPP_ERROR(rclcpp::get_logger("FairinoHardwareInterface"),
+                            "Completed gripper motion has implausible feedback target=%d previous=%u raw=%u",
+                            *position, last_feedback, feedback);
+                        return;
+                    }
+                    resume_arm = true;
+                    break;
+                }
+                const auto now = std::chrono::steady_clock::now();
+                if (feedback_is_plausible && feedback != last_feedback) {
+                    observed_movement = true;
+                    last_feedback = feedback;
+                    non_target_stable_since.reset();
+                }
+                if (feedback_is_plausible && observed_movement &&
+                    feedback != static_cast<uint8_t>(*position)) {
+                    if (!non_target_stable_since.has_value()) non_target_stable_since = now;
+                    if (now - *non_target_stable_since >= settle_time) {
+                        RCLCPP_WARN(rclcpp::get_logger("FairinoHardwareInterface"),
+                            "Gripper motion settled away from target (target=%d, feedback=%u, dwell=%d ms)",
+                            *position, feedback, _gripper_settle_time_ms);
+                        resume_arm = true;
+                        break;
+                    }
+                } else if (feedback_is_plausible) {
+                    non_target_stable_since.reset();
+                }
+                std::unique_lock<std::mutex> lock(_gripper_mutex);
+                _gripper_cv.wait_for(lock, 50ms, [this] {
+                    return _stop_gripper_thread ||
+                        _pending_gripper_position.has_value();
+                });
+                if (_stop_gripper_thread) return;
+                if (_pending_gripper_position.has_value()) {
+                    RCLCPP_WARN(rclcpp::get_logger("FairinoHardwareInterface"),
+                        "Superseding unsettled gripper command target=%d with latest target=%d",
+                        *position, *_pending_gripper_position);
+                    break;
+                }
+                if (std::chrono::steady_clock::now() >= deadline) {
+                    _gripper_error = -1;
+                    RCLCPP_ERROR(rclcpp::get_logger("FairinoHardwareInterface"),
+                        "Gripper motion timed out after %d ms", _gripper_max_time);
+                    return;
+                }
+            }
+            if (resume_arm) {
+                const auto servo_result = send_udp_command_and_observe(
+                    [this] { return _ptr_robot->ServoMoveStart(1); });
+                if (!servo_result.ok()) {
+                    _gripper_error = servo_result.controller_error != 0 ?
+                        servo_result.controller_error :
+                        (servo_result.send_error != 0 ? servo_result.send_error : -4);
+                    RCLCPP_ERROR(rclcpp::get_logger("FairinoHardwareInterface"),
+                        "ServoMoveStart failed after gripper motion (send=%d, reply=%s, controller=%d)",
+                        servo_result.send_error,
+                        servo_result.reply_received ? "received" : "missing",
+                        servo_result.controller_error);
+                    return;
+                }
+                if (_gripper_command_generation.load() == command_generation) {
+                    _arm_stream_paused = false;
+                }
+            }
+            continue;
+        }
+
+        ROBOT_STATE_PKG state{};
+        _gripper_rpc_active = true;
+        const int result = _ptr_robot->GetRobotRealTimeState(&state);
+        _gripper_rpc_active = false;
+        if (result != 0 || state.gripper_fault != 0) {
+            _gripper_error = result != 0 ?
+                result : -static_cast<int>(state.gripper_fault);
+            RCLCPP_ERROR(rclcpp::get_logger("FairinoHardwareInterface"),
+                "GetRobotRealTimeState failed in non-realtime worker, error=%d fault=%u",
+                result, state.gripper_fault);
+            return;
+        }
+        const uint8_t feedback = state.gripper_position;
+        const double last_command = _last_gripper_command.load();
+        const int target = static_cast<int>(std::lround(
+            100.0 * last_command / _gripper_upper_position));
+        const double previous = _gripper_position_state.load();
+        if (feedback > 100 ||
+            (last_command > 0.0 && target > 0 && feedback == 0 && previous > 0.0)) {
+            ++idle_invalid_feedback_samples;
+            if (idle_invalid_feedback_samples == 1) {
+                RCLCPP_WARN(rclcpp::get_logger("FairinoHardwareInterface"),
+                    "Holding last valid idle gripper feedback target=%d raw=%u",
+                    target, feedback);
+            }
+            continue;
+        }
+        if (idle_invalid_feedback_samples != 0) {
+            RCLCPP_WARN(rclcpp::get_logger("FairinoHardwareInterface"),
+                "Idle realtime gripper feedback recovered after %zu invalid samples (target=%d feedback=%u)",
+                idle_invalid_feedback_samples, target, feedback);
+            idle_invalid_feedback_samples = 0;
+        }
+        _gripper_position_state =
+            _gripper_upper_position * static_cast<double>(feedback) / 100.0;
+    }
+}
 

+bool FairinoHardwareInterface::gripper_release_ready()
+{
+    // Read-cycle latch: a worker completing after read cannot release this cycle.
+    std::unique_lock<std::mutex> lock(_gripper_mutex, std::try_to_lock);
+    if (!lock.owns_lock()) return false;
+    const auto &v = _gripper_evidence_values;
+    if (_stop_gripper_thread || _gripper_error.load() || udp_command_error.load()) {
+        _arm_stream_paused = true; return false;
+    }
+    if (v[5] != double(_gripper_command_generation.load()) || v[6] != 0. ||
+        v[22] != 0. || v[23] != 0. || v[24] != 1.)
+        return false;
+    for (size_t i = 0; i < 4; ++i) {
+        if (v[i + 1] != double(_gripper_evidence.incarnation[i])) {
+            _gripper_error = -5; _arm_stream_paused = true; return false;
+        }
+    }
+    const double system = std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+    const double steady = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    if (_require_gripper_source_clock && _precise_clock) {
+        if (v[27] != 1.) return false; // wait for this generation's certified read
+        if (!current_gripper_fresh(v, system, steady, _gripper_current_sample[42]) ||
+            (v[0]>=3. && !causal_gripper_proof_valid(v)) || v[43] != 1. || v[7] != v[5] || (v[21] != 1. && v[21] != 2.)) {
+            _gripper_error = -5; _arm_stream_paused = true; return false;
+        }
+        return true; // completed proof was established under the original command clock
+    }
+    const std::array<double, 7> source{v[12], v[13], v[14], v[15], v[16], v[17], v[18]};
+    const std::array<double, 7> finished{v[28], v[29], v[30], v[31], v[32], v[33], v[34]};
+    if (v[27] != 1. || v[25] != 0. || v[26] != 0. || v[7] != v[5] ||
+        (v[21] != 1. && v[21] != 2.) || finished > source ||
+        system < v[9] || system - v[9] > _gripper_source_clock.values[10] ||
+        steady < v[10] || steady - v[10] > _gripper_source_clock.values[10] ||
+        !_gripper_source_clock.fresh(source, _gripper_evidence.incarnation, system, steady) ||
+        !_gripper_source_clock.after_command(finished, v[11])) {
+        _gripper_error = -5; _arm_stream_paused = true;
+        return false;
+    }
+    return true;

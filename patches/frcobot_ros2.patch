+bool FairinoHardwareInterface::refresh_gripper_freshness(double after_steady)
+{
+    auto cancelled = [this] {
+        std::lock_guard<std::mutex> lock(_gripper_mutex);
+        return _stop_gripper_thread || _gripper_error.load() || udp_command_error.load();
+    };

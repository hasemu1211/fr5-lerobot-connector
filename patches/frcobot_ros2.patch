+    std::vector<double> policy;
+    try { policy = get_node()->get_parameter("gripper_temporal_policy_v1").as_double_array(); }
+    catch (const std::exception &) { return false; }
+    if (policy.size()!=7 || policy[0]!=1.) return false;
+    for(double x:policy) if(!std::isfinite(x)) return false;
+    const double age = policy[5];
+    if (age<=0. || policy[6]<0.) return false;
+    {
+        std::lock_guard<std::mutex> lock(_gripper_mutex);
+        for (size_t i=0; i<4; ++i) if (policy[i+1] != double(_gripper_evidence.incarnation[i])) return false;
+        if (!_gripper_temporal_policy.empty() && _gripper_temporal_policy!=policy) return false;
+        _gripper_temporal_policy=policy;
+        const auto &c = _gripper_current_sample;
+        const double now = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        bool same = c[35] == 1. && c[5] == double(_gripper_command_generation.load()) && _gripper_raw_sample[27] == 1.;
+        for (size_t i : {size_t(6),size_t(7),size_t(8),size_t(21),size_t(22),size_t(23),size_t(24),size_t(25),size_t(26)})
+            same = same && c[i] == _gripper_raw_sample[i];
+        // Reuse only original certified time; reserve the remaining budget for renewal.
+        if (same && c[39]>=after_steady && now-c[39] < age/4.) return true;
+    }
+    const double s0 = std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+    const double m0 = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    // Queries and frame wait spend one original acquisition budget. The
+    // independent read/write owner still rejects an expired certificate while
+    // renewal is in flight; this does not extend any existing evidence lease.
+    const auto timeout_ms = [&] {
+        const double now = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        const double remaining = (age - (now - m0)) * 1000.;
+        if (remaining < 1.) throw std::runtime_error("clock acquisition budget expired");
+        return long(std::min(300., remaining));
+    };
+    try {
+        const double q0 = _precise_clock->read(timeout_ms(), cancelled);
+        if (q0 < _last_controller_clock) throw std::runtime_error("controller clock regressed");
+        std::array<double,35> sample{};
+        ROBOT_STATE_PKG sample_state{};
+        while (true) {
+            std::unique_lock<std::mutex> lock(_gripper_mutex);
+            if (_stop_gripper_thread || _gripper_error.load() || udp_command_error.load()) return false;
+            sample = _gripper_raw_sample; sample_state = _gripper_raw_state;
+            const double now = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+            if (now - m0 >= age) return false;
+            std::array<double,7> stamp{sample[12],sample[13],sample[14],sample[15],sample[16],sample[17],sample[18]};
+            // One millisecond on either side excludes ambiguous calendar quantization ties.
+            if (sample[27] == 1. && sample[5]==double(_gripper_command_generation.load()) && GripperSourceClock::calendar(stamp) - .001 > q0 && sample[10] >= m0) break;

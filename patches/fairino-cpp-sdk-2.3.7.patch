+// No IsSockError here: it can wait for reconnect. Snapshot validity/epoch is
+// supplied by the receiver; this call never renews receipt metadata.
+errno_t FRRobot::GetRobotRealTimeStateSnapshot(RobotStateSnapshot* snapshot)
+{
+    if (!snapshot) return ROBOT_SNAPSHOT_INVALID_ARGUMENT;
+    return cndeClient->GetStateSnapshot(snapshot);

+void FRCNDEClient::RecvRobotStateThread()
+{
+    struct ReceiverExit { std::atomic<bool>& active; ~ReceiverExit() { active = false; } } exit{receiverActive};
+    char pkgBuf[CNDE_MAX_PKG_SIZE] = {};
+    while (robotStateRunFlag) {
+        std::lock_guard<std::mutex> receive_lock(recvCNDEPkgMutex);
+        std::uint64_t epoch;
+        { std::lock_guard<std::mutex> lock(publicationMutex); epoch = published.connection_epoch; }
+        const int recvLen = rtClient->RecvCNDEPkg(pkgBuf);
+        // SDK userspace completion of a FULL frame, not kernel arrival or source time.
+        const auto received_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+        if (!robotStateRunFlag) break;
+        if (recvLen < 0) {
+            InvalidateSnapshot(true);
+            *sockComErr = ERR_SOCKET_COM_FAILED;
+            return;
+        }
+        if (recvLen == 0) {
+            InvalidateSnapshot(true);
+            if (SendCNDEOutputConfig() != 0 || SetCNDEStart() != 0) {
+                *sockComErr = ERR_SOCKET_COM_FAILED;
+                return;
             }
+        } else {
+            PublishReceivedFrame(pkgBuf, recvLen, received_ns, epoch);
         }
     }
     rtClient->Close();

@@ -0,0 +1,20 @@
+#pragma once
+#include "robot_types.h"
+#include <cstdint>
+
+// Candidate additive API. Metadata is local receipt/publication evidence, NOT
+// robot acquisition age, command acknowledgement, or physical completion.
+struct RobotStateSnapshot {
+    ROBOT_STATE_PKG state{}; // only configured fields are meaningful
+    std::int64_t host_receive_steady_ns = 0; // complete frame returned by SDK recv
+    std::uint64_t producer_sequence = 0; // local publications, never command ID
+    std::uint64_t connection_epoch = 0; // local client lifetime only
+    std::uint64_t configuration_epoch = 0;
+    bool valid = false; // complete publication, NOT a freshness/connection-health claim
+};
+enum RobotStateSnapshotResult {
+    ROBOT_SNAPSHOT_OK = 0,
+    ROBOT_SNAPSHOT_UNAVAILABLE = -1,
+    ROBOT_SNAPSHOT_BUSY = -2,
+    ROBOT_SNAPSHOT_INVALID_ARGUMENT = -3
+};

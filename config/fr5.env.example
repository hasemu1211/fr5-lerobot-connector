export ROS_DOMAIN_ID=58
export FR5_CONTROLLER_IP=192.168.58.2
export FR5_GRIPPER_INDEX=1
export FR5_GRIPPER_VELOCITY=80
export FR5_GRIPPER_FORCE=50
export FR5_GRIPPER_MAX_TIME=30000
export FR5_GRIPPER_UPPER_POSITION=0.021
export REALSENSE_NAMESPACE=camera
export REALSENSE_ROLE=up
export REALSENSE_ENABLE_SYNC=false  # RGB-only 수집 기본; depth/color hardware sync가 필요할 때만 true
export FR5_COLLECTION_FPS=30
export FR5_STREAMING_ENCODING=0  # 저자원 수집 기본: episode 종료 후 영상 인코딩
# 기본 수집에서는 설정하지 않는다. 독립 검증된 실험값을 명시적으로 시험할 때만 사용.
# export FR5_EXPERIMENTAL_TIME_OFFSET_PROFILE=config/time-offsets.json
